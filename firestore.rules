rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Users can read/write their own user document
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Integrations - users can read/write their own integrations
    match /integrations/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Gmail account lookup - read only (for webhook)
    // Webhook needs to read this, so we allow read for authenticated users
    // Write is restricted to server-side only (Firebase Admin)
    match /gmailAccountLookup/{accountId} {
      allow read: if isAuthenticated();
      allow write: if false; // Server-side only via Admin SDK
    }

    // Email threads - users can read/write their own threads
    match /emailThreads/{uid}/threads/{threadId} {
      allow read, write: if isOwner(uid);
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Calendar events - users can read/write their own events
    match /calendarEvents/{uid}/events/{eventId} {
      allow read, write: if isOwner(uid);
    }

    // Digests - users can read their own digests
    match /digests/{uid}/runs/{runId} {
      allow read: if isOwner(uid);
      allow write: if false; // Server-side only
    }

    // Chat sessions - users can read/write their own sessions
    match /chatSessions/{uid}/sessions/{sessionId} {
      allow read, write: if isOwner(uid);
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Audit logs - read only for users
    match /auditLogs/{uid}/items/{logId} {
      allow read: if isOwner(uid);
      allow write: if false; // Server-side only
    }
  }
}
